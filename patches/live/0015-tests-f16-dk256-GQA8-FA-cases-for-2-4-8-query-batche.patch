+++ b/tests/test-backend-ops.cpp
@@ -11549,7 +11549,9 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         }
         // f16 KV decode (the MTP draft context); at kv=32768 f16 sits at the NMSE threshold for every kernel
         if (kv < 32768) {
