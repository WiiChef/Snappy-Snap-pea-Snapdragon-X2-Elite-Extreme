From a89c4bf7764c4e05a322de532b34624c6285270f Mon Sep 17 00:00:00 2001
From: snap-pea <snap-pea@users.noreply.github.com>
Date: Mon, 5 Oct 2026 22:10:08 -0400
Subject: [PATCH 19/19] opencl: unroll the dk256 FA decode PV loop by 2 by
 default

+1.5-2% plain decode at 64k (25.66/25.49 vs 25.17/25.13), +0.8% at 32k; 4 flat, 8 slower. Same arithmetic order. GGML_OPENCL_FA_PV_UNROLL=n overrides (1 = off).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-opencl/ggml-opencl.cpp                 | 12 +++++++++++-
 ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl |  3 +++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-opencl/ggml-opencl.cpp b/ggml/src/ggml-opencl/ggml-opencl.cpp
index d515dab..7d0e701 100644
--- a/ggml/src/ggml-opencl/ggml-opencl.cpp
+++ b/ggml/src/ggml-opencl/ggml-opencl.cpp
@@ -6543,8 +6543,18 @@ static void load_cl_kernels(ggml_backend_opencl_context *backend_ctx) {
 #else
         const std::string kernel_src = read_file("mul_mv_q8_0_f32_flat.cl");
 #endif
+        // unroll factor of the dk256 FA decode PV loop: 2 is +1.5-2% decode at 64k (4 flat, 8 slower).
+        // GGML_OPENCL_FA_PV_UNROLL=n overrides, 1 = no unroll.
+        std::string flat_opts = compile_opts;
+        {
+            const char * e = getenv("GGML_OPENCL_FA_PV_UNROLL");
+            const int u = (e && e[0]) ? atoi(e) : 2;
+            if (u > 1) {
+                flat_opts += " -DFAD_PV_UNROLL=" + std::to_string(u);
+            }
+        }
         backend_ctx->program_mul_mv_q8_0_f32_flat =
-            build_program_from_source(backend_ctx, kernel_src.c_str(), compile_opts);
+            build_program_from_source(backend_ctx, kernel_src.c_str(), flat_opts);
 
         CL_CHECK((backend_ctx->kernel_mul_mv_q8_0_f32_flat = clCreateKernel(backend_ctx->program_mul_mv_q8_0_f32_flat, "kernel_mul_mv_q8_0_f32_flat", &err), err));
         CL_CHECK((backend_ctx->kernel_mul_mv_q8_0_f32_flat_mc = clCreateKernel(backend_ctx->program_mul_mv_q8_0_f32_flat, "kernel_mul_mv_q8_0_f32_flat_mc", &err), err));
diff --git a/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl b/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl
index 4d0f419..8062c87 100644
--- a/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl
+++ b/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl
@@ -716,6 +716,9 @@ kernel void kernel_fa_q8_d256_g8_dec(
 
         const int nr = min(64, kv_end - t0);
         const global char * vrow = v_base + (ulong) t0 * v_nb1 + vb * FAD_BLK;
+#ifdef FAD_PV_UNROLL
+        #pragma unroll FAD_PV_UNROLL
+#endif
         for (int i = 0; i < nr; ++i) {
             const global char * vblk = vrow + (ulong) i * v_nb1;
             const float  vd = vload_half(0, (const global half *) vblk);
-- 
