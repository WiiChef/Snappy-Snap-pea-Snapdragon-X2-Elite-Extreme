+++ b/ggml/src/ggml-opencl/ggml-opencl.cpp
@@ -1608,6 +1608,8 @@ struct ggml_backend_opencl_context {
     cl_kernel kernel_q8mc_quant_act = nullptr;           // dp4a verify GEMV: activation quantizer
     cl_kernel kernel_mul_mv_q8_0_q8a_dp4a_mc = nullptr;  // dp4a verify GEMV (2..8 columns)
     cl_kernel kernel_mul_mv_q8_0_q8a_dp4a_mc_lds = nullptr; // same, activations staged in local memory
+    cl_kernel kernel_mul_mv_q8_0_q8a_dp4a_mc_w[9]     = {}; // per-width builds (-DMC_NCOL=n), n = 2..8
+    cl_kernel kernel_mul_mv_q8_0_q8a_dp4a_mc_lds_w[9] = {};
     cl_kernel kernel_fa_q8_d256_g8_dec = nullptr;        // q8_0 KV dk256 gqa8 decode FA split (row-per-lane QK)
     cl_kernel kernel_fa_f16_d256_g8_dec = nullptr;       // f16 KV twin (MTP draft context)
     cl_kernel kernel_mul_mat_q8_0_f32_kq_gen = nullptr;
@@ -2064,6 +2066,7 @@ struct ggml_backend_opencl_context {
     int q80_dp4a_narrow_max = 16;   // widest ne1 routed to the narrow tile
     cl_kernel kernel_gemv_noshuffle_q8_0_f32;
     cl_kernel kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk = nullptr; // small-M 2..8-column int8 split-K GEMV
+    cl_kernel kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk_w[9] = {}; // per-width builds (-DMC_NCOL=n)
     cl_kernel kernel_gemv_noshuffle_q8_0_f32_splitk;  // split-K across WGs (small-M decode)
     cl_kernel kernel_gemm_noshuffle_q1_0_f32;
     cl_kernel kernel_gemv_noshuffle_q1_0_f32;
@@ -6645,6 +6648,19 @@ static void load_cl_kernels(ggml_backend_opencl_context *backend_ctx) {
                 GGML_LOG_WARN("ggml_opencl: kernel_mul_mv_q8_0_q8a_dp4a_mc_lds unavailable (err %d)\n", err);
                 backend_ctx->kernel_mul_mv_q8_0_q8a_dp4a_mc_lds = nullptr;
             }
+            // fixed-width builds of the verify GEMVs (accumulators sized for the actual width).
+            // Opt out: GGML_OPENCL_Q8_MC_FIXED=0.
+            if (!ggml_cl_env_flag_zero("GGML_OPENCL_Q8_MC_FIXED") && backend_ctx->kernel_mul_mv_q8_0_q8a_dp4a_mc != nullptr) {
+                for (int n = 2; n <= 8; ++n) {
+                    cl_program pw = build_program_from_source(backend_ctx, kernel_src.c_str(), compile_opts + " -DMC_NCOL=" + std::to_string(n));
+                    cl_int e1 = CL_SUCCESS, e2 = CL_SUCCESS;
+                    cl_kernel k1 = clCreateKernel(pw, "kernel_mul_mv_q8_0_q8a_dp4a_mc", &e1);
+                    cl_kernel k2 = clCreateKernel(pw, "kernel_mul_mv_q8_0_q8a_dp4a_mc_lds", &e2);
+                    backend_ctx->kernel_mul_mv_q8_0_q8a_dp4a_mc_w[n]     = e1 == CL_SUCCESS ? k1 : nullptr;
+                    backend_ctx->kernel_mul_mv_q8_0_q8a_dp4a_mc_lds_w[n] = e2 == CL_SUCCESS ? k2 : nullptr;
+                    CL_CHECK(clReleaseProgram(pw));
+                }
+            }
             backend_ctx->kernel_fa_f16_d256_g8_dec = clCreateKernel(backend_ctx->program_mul_mv_q8_0_f32_flat, "kernel_fa_f16_d256_g8_dec", &err);
             if (err != CL_SUCCESS) {
                 GGML_LOG_WARN("ggml_opencl: kernel_fa_f16_d256_g8_dec unavailable (err %d)\n", err);
@@ -9672,6 +9688,15 @@ static void load_cl_kernels(ggml_backend_opencl_context *backend_ctx) {
             backend_ctx->kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk = nullptr;
         }
         CL_CHECK(clReleaseProgram(prog));
+        if (!ggml_cl_env_flag_zero("GGML_OPENCL_Q8_MC_FIXED") && backend_ctx->kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk != nullptr) {
+            for (int n = 2; n <= 8; ++n) {
+                cl_program pw = build_program_from_source(backend_ctx, kernel_src_CL_gemv_general.c_str(), CL_gemv_compile_opts + " -DMC_NCOL=" + std::to_string(n));
+                cl_int e1 = CL_SUCCESS;
+                cl_kernel k1 = clCreateKernel(pw, "kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk", &e1);
+                backend_ctx->kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk_w[n] = e1 == CL_SUCCESS ? k1 : nullptr;
+                CL_CHECK(clReleaseProgram(pw));
+            }
+        }
         GGML_LOG_CONT(".");
     }
 
@@ -39333,7 +39358,9 @@ static void ggml_cl_mul_mat_q8_0_f32_adreno(ggml_backend_t backend, const ggml_t
             backend_ctx->prealloc_splitk_partial.allocate(context, (size_t) ksplit * ncol * M * sizeof(float));
             cl_mem partial = backend_ctx->prealloc_splitk_partial.buffer;
 
-            cl_kernel kd = backend_ctx->kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk;
+            cl_kernel kd = backend_ctx->kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk_w[ncol] != nullptr
+                         ? backend_ctx->kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk_w[ncol]
+                         : backend_ctx->kernel_gemv_noshuffle_q8_0_q8a_dp4a_mc_splitk;
             CL_CHECK(clSetKernelArg(kd, 0, sizeof(cl_mem), &q_img));
             CL_CHECK(clSetKernelArg(kd, 1, sizeof(cl_mem), &extra0_q8_0->d));
             CL_CHECK(clSetKernelArg(kd, 2, sizeof(cl_mem), &qa));
@@ -48507,6 +48534,11 @@ static void ggml_cl_mul_mat(ggml_backend_t backend, const ggml_tensor * src0, co
                                      (size_t) ncol * ne00 <= 16384;
                 cl_kernel km = use_lds ? backend_ctx->kernel_mul_mv_q8_0_q8a_dp4a_mc_lds
                                        : backend_ctx->kernel_mul_mv_q8_0_q8a_dp4a_mc;
+                {
+                    cl_kernel kw = use_lds ? backend_ctx->kernel_mul_mv_q8_0_q8a_dp4a_mc_lds_w[ncol]
+                                           : backend_ctx->kernel_mul_mv_q8_0_q8a_dp4a_mc_w[ncol];
+                    if (kw != nullptr) km = kw;
+                }
                 CL_CHECK(clSetKernelArg(km,  0, sizeof(cl_mem),   &extra0_q8_0->q));
                 CL_CHECK(clSetKernelArg(km,  1, sizeof(cl_mem),   &extra0_q8_0->d));
                 CL_CHECK(clSetKernelArg(km,  2, sizeof(cl_mem),   &qa));
