From eb778a0b59de9884614610334340751225930775 Mon Sep 17 00:00:00 2001
From: snap-pea <snap-pea@users.noreply.github.com>
Date: Sun, 4 Oct 2026 20:02:05 -0400
Subject: [PATCH 06/19] opencl: log the size of a failed scratch-buffer
 allocation

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-opencl/ggml-opencl.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-opencl/ggml-opencl.cpp b/ggml/src/ggml-opencl/ggml-opencl.cpp
index d10dd3a65..6cb0f8fef 100644
--- a/ggml/src/ggml-opencl/ggml-opencl.cpp
+++ b/ggml/src/ggml-opencl/ggml-opencl.cpp
@@ -623,7 +623,11 @@ struct ggml_cl_buffer {
                 CL_CHECK(clReleaseMemObject(buffer));
             }
             cl_int err;
-            CL_CHECK((buffer = clCreateBuffer(context, CL_MEM_READ_WRITE, size, NULL, &err), err));
+            buffer = clCreateBuffer(context, CL_MEM_READ_WRITE, size, NULL, &err);
+            if (err != CL_SUCCESS) {
+                fprintf(stderr, "ggml_cl_buffer::allocate: clCreateBuffer(%zu bytes) failed: %d\n", size, err); fflush(stderr);
+            }
+            CL_CHECK(err);
         }
     }
 };
