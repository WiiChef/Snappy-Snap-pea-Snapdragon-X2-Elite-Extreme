From f8ba50655b93874bd87cd0ac1b26e4467ef3594b Mon Sep 17 00:00:00 2001
From: snap-pea <snap-pea@users.noreply.github.com>
Date: Sun, 4 Oct 2026 07:39:07 -0400
Subject: [PATCH 03/19] ggml : fix multi-column Q8_0 GEMV activation block
 index; drop size guard

The _mc kernel read activation block ix (subgroup lane) instead of loop block ib, so every
column past the first 512 inputs used wrong activations. With the fix MTP output is coherent
for large vocab projections; the 248320-row LM head 4-col verify drops ~16.7 -> ~7.8 ms.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-opencl/ggml-opencl.cpp                 | 4 ++--
 ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-opencl/ggml-opencl.cpp b/ggml/src/ggml-opencl/ggml-opencl.cpp
index 62caa1cc8..fe4d70786 100644
--- a/ggml/src/ggml-opencl/ggml-opencl.cpp
+++ b/ggml/src/ggml-opencl/ggml-opencl.cpp
@@ -48294,11 +48294,11 @@ static void ggml_cl_mul_mat(ggml_backend_t backend, const ggml_tensor * src0, co
         }
         case GGML_TYPE_Q8_0: {
 #ifdef GGML_OPENCL_SOA_Q
-            if (ne01 < 32768 && ne11 >= 2 && ne11 <= 4 && ne11 == ne1 &&
+            if (ne11 >= 2 && ne11 <= 4 && ne11 == ne1 &&
                 backend_ctx->kernel_mul_mv_q8_0_f32_flat_mc != nullptr) {
                 kernel = backend_ctx->kernel_mul_mv_q8_0_f32_flat_mc;
                 ncols_per_wg = 4;
-            } else if (ne01 < 32768 && ne11 >= 5 && ne11 <= 8 && ne11 == ne1 &&
+            } else if (ne11 >= 5 && ne11 <= 8 && ne11 == ne1 &&
                        backend_ctx->kernel_mul_mv_q8_0_f32_flat_mc8 != nullptr) {
                 kernel = backend_ctx->kernel_mul_mv_q8_0_f32_flat_mc8;
                 ncols_per_wg = 8;
diff --git a/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl b/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl
index d1b78cfa8..a8a159221 100644
--- a/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl
+++ b/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat.cl
@@ -300,7 +300,7 @@ kernel void kernel_mul_mv_q8_0_f32_flat_mc(
             const int col = first_col + c;
             if (col < ne1) {
                 global float * y = (global float *)(src1 + offset_src1_base + col*nb11);
-                float8 yl = vload8(0, y + ix*QK8_0 + il*NB_Q8_0);
+                float8 yl = vload8(0, y + ib*QK8_0 + il*NB_Q8_0);
 
                 float sumq0 = 0.f;
                 sumq0 += qv0.s0*yl.s0;
-- 
