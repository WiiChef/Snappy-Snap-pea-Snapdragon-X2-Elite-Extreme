From 2cfc11e04ac91d2a5e9c62175ac969f57ad4540e Mon Sep 17 00:00:00 2001
From: snap-pea <snap-pea@users.noreply.github.com>
Date: Mon, 5 Oct 2026 04:12:42 -0400
Subject: [PATCH 10/19] opencl: skip padded token slots in the q6_K MoE
 reorder+quant pre-pass when the GEMM is ragged

kernel_moe_reorder_quant_a_q8_1 quantized every slot of every expert tile, writing
zeros for the padding, although the ragged dp4a GEMM never reads padded slots. A
speculative-verify batch (2..8 tokens over ~35 distinct experts) is almost all
padding: the pre-pass cost 5.3 ms per pp5 batch. kernel_moe_reorder_quant_a_q8_1_ragged
returns early on padded slots; used on the q6_K dp4a path when moe_gemm_ragged.

X2-90 Qwen3.6-35B-A3B: pp5 @ d512 74.4 -> 77.5 t/s, pp512 554 -> 560 t/s; greedy MTP
output byte-identical. Opt out: GGML_OPENCL_MOE_REORDER_SKIP_PAD=0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-opencl/ggml-opencl.cpp          | 11 +++-
 .../kernels/moe_reorder_quant_a_q8_1.cl       | 59 +++++++++++++++++++
 2 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-opencl/ggml-opencl.cpp b/ggml/src/ggml-opencl/ggml-opencl.cpp
index d1861165a..959abe14f 100644
--- a/ggml/src/ggml-opencl/ggml-opencl.cpp
+++ b/ggml/src/ggml-opencl/ggml-opencl.cpp
@@ -1694,6 +1694,7 @@ struct ggml_backend_opencl_context {
     cl_kernel kernel_gemv_moe_q4_k_f32_ns_wimg = nullptr;  // weight-as-texture MoE decode GEMV (opt-in)
     cl_kernel kernel_gemm_moe_q4_k_q8_1_dp4a = nullptr;    // dp4a (int8) prefill GEMM variant
     cl_kernel kernel_moe_reorder_quant_a_q8_1;   // fused reorder + q8_1 quant for the dp4a GEMM
+    cl_kernel kernel_moe_reorder_quant_a_q8_1_ragged = nullptr; // same, padded slots skipped (ragged GEMM)
     cl_kernel kernel_gemm_moe_q8_1_dp4a_q80 = nullptr;   // generic dp4a MoE GEMM (MOE_QT=80), opt-in
     cl_kernel kernel_moe_expand_scale_q8_0 = nullptr;    // q8_0 per-block d -> uniform scale[16]
     cl_kernel kernel_gemm_moe_q8_1_dp4a_q50 = nullptr;   // generic dp4a MoE GEMM (MOE_QT=50, q5_0), opt-in
@@ -10950,6 +10951,8 @@ static void load_cl_kernels(ggml_backend_opencl_context *backend_ctx) {
             build_program_from_source(backend_ctx, kernel_src.c_str(), CL_moe_compile_opts);
 
         CL_CHECK((backend_ctx->kernel_moe_reorder_quant_a_q8_1 = clCreateKernel(prog, "kernel_moe_reorder_quant_a_q8_1", &err), err));
+        backend_ctx->kernel_moe_reorder_quant_a_q8_1_ragged = clCreateKernel(prog, "kernel_moe_reorder_quant_a_q8_1_ragged", &err);
+        if (err != CL_SUCCESS) { backend_ctx->kernel_moe_reorder_quant_a_q8_1_ragged = nullptr; }
         CL_CHECK(clReleaseProgram(prog));
         GGML_LOG_CONT(".");
     }
@@ -53110,7 +53113,13 @@ static void ggml_cl_mul_mat_id(ggml_backend_t backend, const ggml_tensor * src0,
 
                         // fused reorder + q8_1 quant from the original activations
                         const cl_uint n_kblocks = (cl_uint)(ne00 / 32);
-                        cl_kernel rq = backend_ctx->kernel_moe_reorder_quant_a_q8_1;
+                        // the ragged GEMM never reads padded token slots, so leave them unwritten.
+                        // Opt out: GGML_OPENCL_MOE_REORDER_SKIP_PAD=0.
+                        static const bool rq_skip_pad = !ggml_cl_env_flag_zero("GGML_OPENCL_MOE_REORDER_SKIP_PAD");
+                        cl_kernel rq = (rq_skip_pad && backend_ctx->moe_gemm_ragged &&
+                                        backend_ctx->kernel_moe_reorder_quant_a_q8_1_ragged != nullptr)
+                                     ? backend_ctx->kernel_moe_reorder_quant_a_q8_1_ragged
+                                     : backend_ctx->kernel_moe_reorder_quant_a_q8_1;
                         CL_CHECK(clSetKernelArg(rq, 0, sizeof(cl_mem),         &sub_buf_src1_pre));
                         CL_CHECK(clSetKernelArg(rq, 1, sizeof(cl_mem),         &buf_src2));
                         CL_CHECK(clSetKernelArg(rq, 2, sizeof(cl_mem),         &backend_ctx->prealloc_moe_qa.buffer));
diff --git a/ggml/src/ggml-opencl/kernels/moe_reorder_quant_a_q8_1.cl b/ggml/src/ggml-opencl/kernels/moe_reorder_quant_a_q8_1.cl
index 0d16f3abd..1d2669429 100644
--- a/ggml/src/ggml-opencl/kernels/moe_reorder_quant_a_q8_1.cl
+++ b/ggml/src/ggml-opencl/kernels/moe_reorder_quant_a_q8_1.cl
@@ -62,3 +62,62 @@ __kernel void kernel_moe_reorder_quant_a_q8_1(
     da[bidx] = (half)d;
     sa[bidx] = (half)(d * (float)sum);
 }
+
+// Same as above, for the ragged dp4a GEMM, which skips padded token slots: padded slots are left untouched.
+__kernel void kernel_moe_reorder_quant_a_q8_1_ragged(
+        __global const float  * src,        // original activations (offset applied)
+        __global const uint   * router,     // post-router indices [tok_slots]
+        __global       char   * qa,
+        __global       half   * da,
+        __global       half   * sa,
+        __global const int    * total_tiles,
+        uint  K,
+        ushort map_ratio,
+        uint  tile_size,
+        uint  n_kblocks                      // K / 32
+) {
+    const uint blk = get_global_id(0);       // 32-block along K
+    const uint tok = get_global_id(1);       // token slot (post_router_idx)
+
+    if (blk >= n_kblocks || tok >= (uint)total_tiles[0] * tile_size) {
+        return;
+    }
+
+    const uint out_base = tok * K + blk * 32;
+    const uint bidx     = tok * n_kblocks + blk;
+
+    const uint router_idx = router[tok];
+    // ragged GEMM never reads padded slots: skip the zero-fill (small speculative-verify batches are mostly padding)
+    if (router_idx == 0xFFFFFFFF) {
+        return;
+    }
+
+    float v[32];
+    float amax = 0.0f;
+    if (router_idx == 0xFFFFFFFF) {
+        #pragma unroll
+        for (int i = 0; i < 32; ++i) v[i] = 0.0f;
+    } else {
+        const uint act_idx = router_idx / map_ratio;
+        const uint in_base = act_idx * K + blk * 32;
+        #pragma unroll
+        for (int i = 0; i < 32; ++i) {
+            v[i] = src[in_base + i];
+            amax = fmax(amax, fabs(v[i]));
+        }
+    }
+
+    const float d  = amax / 127.0f;
+    const float id = (amax > 0.0f) ? (127.0f / amax) : 0.0f;
+
+    int sum = 0;
+    #pragma unroll
+    for (int i = 0; i < 32; ++i) {
+        const int q = (int)rint(v[i] * id);
+        qa[out_base + i] = (char)q;
+        sum += q;
+    }
+
+    da[bidx] = (half)d;
+    sa[bidx] = (half)(d * (float)sum);
+}
