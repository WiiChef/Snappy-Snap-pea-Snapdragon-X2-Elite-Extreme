+    // Probabilistic drafting on the fast path: re-weight fast_topk's 10 candidates at the target
+    // temperature (what the retuned top-k 10 + temp chain yields) and draw one from them.
+    std::vector<common_params_sampling> smpls_cfg;
+    std::mt19937 prob_rng;
+    uint32_t     prob_seed   = 0;
+    bool         prob_seeded = false;
+
+    const llama_token_data_array * fast_temp_sample(float temp, llama_token & id_out) {
+        const float inv_t = 1.0f / std::max(temp, 1e-4f);
+        const float mx = fast_cand[0].logit;
+        float sum = 0.0f;
+        for (auto & d : fast_cand) {
+            d.p = expf((d.logit - mx) * inv_t);
+            sum += d.p;
+        }
+        for (auto & d : fast_cand) d.p /= sum;
+
+        std::uniform_real_distribution<float> u(0.0f, 1.0f);
+        float r = u(prob_rng);
+        id_out = fast_cand.back().id;
+        for (const auto & d : fast_cand) {
+            r -= d.p;
+            if (r <= 0.0f) {
+                id_out = d.id;
+                break;
+            }
+        }
+        return &fast_arr;
+    }
